rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /systems/{systemId} {
      allow read, write: if true;
    }

    match /accessories/{accessoryId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
